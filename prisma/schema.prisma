generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// MÓDULO 1 — Usuarios, Sesiones y Auditoría
// ============================================

enum Rol {
  GERENTE
  OPERARIO
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

model Usuario {
  id           String        @id @default(uuid())
  usuario      String        @unique
  passwordHash String
  nombre       String
  celular      String?
  email        String?
  rol          Rol
  estado       EstadoUsuario @default(ACTIVO)
  creadoEn     DateTime      @default(now())

  sesiones               SesionActiva[]
  auditLogs              AuditLog[]
  bitacoras              BitacoraGlobal[]
  mortalidades           RegistroMortalidad[]
  recolecciones          RegistroRecoleccion[]
  movimientosSueltos     MovimientoSueltos[]
  registrosConsolidacion RegistroConsolidacion[] // Sprint 7
  precios                PrecioKilo[]
  ventas                 Venta[]
  abonosRecibidos        HistorialAbonos[]
  egresosRegistrados     Egreso[]
  empleadoVinculado      Empleado?
  pushSubscriptions      PushSubscription[]

  @@index([rol])
  @@index([estado])
}

model SesionActiva {
  id              String    @id @default(uuid())
  usuarioId       String
  jti             String    @unique
  creadaEn        DateTime  @default(now())
  ultimaActividad DateTime  @default(now())
  revocada        Boolean   @default(false)
  revocadaEn      DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([jti, revocada])
}

model AuditLog {
  id            String   @id @default(uuid())
  entidad       String
  entidadId     String
  accion        String
  estadoAntes   Json?
  estadoDespues Json?
  usuarioId     String
  ip            String?
  creadoEn      DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId])
  @@index([creadoEn])
}

// ============================================
// MÓDULO 2 — Galpones y Lotes
// ============================================

enum EstadoLote {
  ACTIVO
  INACTIVO
}

enum EstadoGalpon {
  ACTIVO
  INACTIVO
}

model Galpon {
  id              String       @id @default(uuid())
  nombre          String
  capacidadMaxima Int
  estado          EstadoGalpon @default(ACTIVO)
  creadoEn        DateTime     @default(now())

  historialUbicaciones HistorialUbicacionLote[]
  inventarioSueltos    InventarioSueltos[]
  movimientosSueltos   MovimientoSueltos[]
  paqueteOrigenes      PaqueteOrigen[]
  bandejaOrigenes      BandejaOrigen[]
  recolecciones        RegistroRecoleccion[]
  mortalidades         RegistroMortalidad[]
  detalleVentas        DetalleVenta[]

  @@index([nombre])
  @@index([estado])
}

model Lote {
  id                 String     @id @default(uuid())
  codigo             String     @unique
  fechaIngreso       DateTime
  avesIniciales      Int
  avesVivas          Int
  // Edad de las aves, en semanas, al momento de fechaIngreso — no siempre
  // es 0: cubre lotes que ingresan como recría ya crecida, no solo
  // pollitos de un día. La "edad actual" NUNCA se guarda acá — se
  // calcula al leer (server/services/lote.ts, calcularEdadEnSemanas) a
  // partir de este valor + fechaIngreso, para no desactualizarse.
  edadInicialSemanas Int        @default(0)
  estado             EstadoLote @default(ACTIVO)

  historialUbicaciones HistorialUbicacionLote[]
  inventarioSueltos    InventarioSueltos[]
  movimientosSueltos   MovimientoSueltos[]
  recolecciones        RegistroRecoleccion[]
  mortalidades         RegistroMortalidad[]
  detalleVentas        DetalleVenta[]
  paqueteOrigenes      PaqueteOrigen[] // Sprint 7
  bandejaOrigenes      BandejaOrigen[] // Sprint 7

  @@index([estado])
  @@index([fechaIngreso])
}

model HistorialUbicacionLote {
  id           String    @id @default(uuid())
  loteId       String
  galponId     String
  fechaEntrada DateTime  @default(now())
  fechaSalida  DateTime?

  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Cascade)
  galpon Galpon @relation(fields: [galponId], references: [id], onDelete: Restrict)

  @@index([loteId, fechaSalida])
  @@index([galponId])
}

// ============================================
// MÓDULO 3 — Bitácora (D2: siempre general, sin galpón)
// ============================================

enum CategoriaBitacora {
  ALIMENTACION
  VACUNACION
  OBSERVACION
}

model BitacoraGlobal {
  id        String            @id @default(uuid())
  fecha     DateTime          @default(now())
  // Reloj del celular en el momento de la captura (Sprint 14, Contrato
  // Offline-Ready) — nullable, sin backfill: las filas existentes no
  // tienen forma de reconstruirlo. Mismo criterio que
  // RegistroRecoleccion.creadoEnCliente (Sprint 5); `fecha` sigue siendo
  // el timestamp de servidor, no se renombra (ver plan.md, "Divergencia
  // de nombre").
  creadoEnCliente DateTime?
  usuarioId String
  categoria CategoriaBitacora
  contenido String
  // Soft-delete (post-Sprint 4, sin ventana de tiempo: una nota se puede
  // editar/eliminar en cualquier momento) — nunca DELETE físico, misma
  // regla no negociable que el resto de entidades de negocio.
  eliminada Boolean           @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([fecha])
  @@index([categoria])
}

// ============================================
// MÓDULO 2b — Mortalidad
// ============================================

enum TipoMortalidad {
  MUERTE
  DESCARTE
}

model RegistroMortalidad {
  id          String         @id @default(uuid())
  loteId      String
  galponId    String
  usuarioId   String
  tipo        TipoMortalidad
  cantidad    Int
  fecha       DateTime       @default(now())
  // Reloj del celular en el momento de la captura (Sprint 14, Contrato
  // Offline-Ready) — nullable, sin backfill, mismo criterio que
  // BitacoraGlobal.creadoEnCliente de arriba. `fecha` sigue siendo el
  // timestamp de servidor, usado en la ventana de gracia de abajo.
  creadoEnCliente DateTime?
  // Ventana de gracia de 10 minutos (post-Sprint 4): revertir un registro
  // restaura avesVivas y marca revertido — nunca DELETE físico, mismo
  // criterio que RegistroRecoleccion.revertido (Sprint 6 del roadmap).
  revertido   Boolean        @default(false)
  revertidoEn DateTime?

  lote    Lote    @relation(fields: [loteId], references: [id], onDelete: Restrict)
  galpon  Galpon  @relation(fields: [galponId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([loteId, fecha])
  // Sprint 15 — sumarMortalidadEnRango/listarMortalidadEnRango filtran por
  // fecha en toda la granja, SIN loteId (a diferencia de todo lo demás en
  // este modelo hasta ahora). El índice [loteId, fecha] no sirve para ese
  // patrón (Postgres necesita loteId como predicado inicial para usarlo) —
  // sin este índice nuevo, el dashboard y cada carga de /reportes fuerzan
  // un seq scan completo de la tabla. Mismo criterio que ya usa
  // RegistroRecoleccion([creadoEn, revertido]).
  @@index([fecha, revertido])
}

// ============================================
// MÓDULO 4 — Recolección e Inventario
// ============================================

enum TipoPaquete {
  PURO
  MIXTO
}

enum EstadoPaquete {
  DISPONIBLE
  VENDIDO
  ROTO
  ANULADO
}

// Sprint 7 — ancla de idempotencia + auditoría de una corrida del wizard de
// Consolidación, que crea N Paquete (tipo MIXTO) o N BandejaSuelta a la vez.
// Mismo rol que RegistroRecoleccion (id generado en el cliente, creado
// primero dentro de la transacción — si colisiona con P2002, nada más se
// ejecuta), pero un solo modelo sirve para los dos wizards, distinguidos
// por `tipo` (solo una de las dos relaciones, paquetes o bandejas, queda
// poblada según el caso).
enum TipoConsolidacion {
  PAQUETE_MIXTO
  BANDEJA
}

model RegistroConsolidacion {
  id              String            @id @default(uuid())
  tipo            TipoConsolidacion
  usuarioId       String
  creadoEnCliente DateTime?
  creadoEn        DateTime          @default(now())
  // Campos calculados persistidos a propósito (excepción documentada en
  // memory/modelo-datos.md): no se pueden recalcular después de leer sin
  // volver a contar paquetes/bandejas — son una comodidad de lectura para
  // AuditLog/reportes, no una fuente de verdad alternativa.
  cantidadUnidadesFormadas Int
  cantidadConsolidada      Int

  usuario  Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  paquetes Paquete[]
  bandejas BandejaSuelta[]

  @@index([creadoEn])
}

model Paquete {
  id                      String                 @id @default(uuid())
  peso                    Decimal                @db.Decimal(6, 3)
  tipo                    TipoPaquete
  estado                  EstadoPaquete          @default(DISPONIBLE)
  registroRecoleccionId   String?
  registroConsolidacionId String? // Sprint 7
  creadoEn                DateTime               @default(now())

  registroRecoleccion   RegistroRecoleccion?   @relation(fields: [registroRecoleccionId], references: [id], onDelete: SetNull)
  registroConsolidacion RegistroConsolidacion? @relation(fields: [registroConsolidacionId], references: [id], onDelete: SetNull)
  origenes              PaqueteOrigen[]
  detalleVentas         DetalleVenta[]
  rotura                RoturaPaquete?

  @@index([estado])
  @@index([tipo])
  @@index([registroRecoleccionId])
  @@index([registroConsolidacionId])
}

model PaqueteOrigen {
  id        String  @id @default(uuid())
  paqueteId String
  galponId  String
  // Nullable: filas creadas antes de Sprint 7 no tienen forma confiable de
  // backfillearse (ver R5 en specs/sprint-07-consolidacion-residuos/spec.md).
  // Todo código nuevo desde este sprint (Consolidación y también
  // registrarRecoleccion) lo completa siempre.
  loteId    String?
  cantidad  Int

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  galpon  Galpon  @relation(fields: [galponId], references: [id], onDelete: Restrict)
  lote    Lote?   @relation(fields: [loteId], references: [id], onDelete: Restrict)

  @@index([paqueteId])
}

enum EstadoBandeja {
  DISPONIBLE
  VENDIDO
  ROTO // Sprint 10 — mismo criterio que EstadoPaquete.ROTO (Sprint 0)
}

model BandejaSuelta {
  id                      String        @id @default(uuid())
  peso                    Decimal       @db.Decimal(6, 3)
  estado                  EstadoBandeja @default(DISPONIBLE)
  registroConsolidacionId String? // Sprint 7 — primer campo de procedencia real de este modelo
  creadoEn                DateTime      @default(now())

  registroConsolidacion RegistroConsolidacion? @relation(fields: [registroConsolidacionId], references: [id], onDelete: SetNull)
  origenes              BandejaOrigen[]
  detalleVentas         DetalleVenta[]
  rotura                RoturaBandeja? // Sprint 10 (relación inversa)

  @@index([estado])
  @@index([registroConsolidacionId])
}

model BandejaOrigen {
  id        String  @id @default(uuid())
  bandejaId String
  galponId  String
  loteId    String? // Sprint 7 — mismo criterio que PaqueteOrigen.loteId
  cantidad  Int

  bandeja BandejaSuelta @relation(fields: [bandejaId], references: [id], onDelete: Cascade)
  galpon  Galpon        @relation(fields: [galponId], references: [id], onDelete: Restrict)
  lote    Lote?         @relation(fields: [loteId], references: [id], onDelete: Restrict)

  @@index([bandejaId])
}

model InventarioSueltos {
  id       String @id @default(uuid())
  galponId String
  loteId   String
  cantidad Int    @default(0)

  galpon Galpon @relation(fields: [galponId], references: [id], onDelete: Restrict)
  lote   Lote   @relation(fields: [loteId], references: [id], onDelete: Restrict)

  @@unique([galponId, loteId])
}

enum TipoMovimientoSueltos {
  RECOLECCION
  CONSOLIDACION_SALIDA
  ROTURA_PAQUETE_ENTRADA
  ROTURA_BANDEJA_ENTRADA // Sprint 10 — distingue en el ledger si la entrada vino de romper un Paquete o una Bandeja
  VENTA_SUELTO
  REVERSION
  AJUSTE_GERENTE
}

model MovimientoSueltos {
  id           String                @id @default(uuid())
  galponId     String
  loteId       String
  tipo         TipoMovimientoSueltos
  cantidad     Int
  referenciaId String?
  motivo       String?
  usuarioId    String
  creadoEn     DateTime              @default(now())

  galpon  Galpon  @relation(fields: [galponId], references: [id], onDelete: Restrict)
  lote    Lote    @relation(fields: [loteId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([galponId, loteId, creadoEn])
}

model RegistroRecoleccion {
  id              String    @id @default(uuid())
  loteId          String
  galponId        String
  usuarioId       String
  cantidadTotal   Int
  creadoEnCliente DateTime?
  creadoEn        DateTime  @default(now())
  // Ventana de gracia de 10 minutos (Sprint 6, mismo criterio que
  // RegistroMortalidad.revertido/revertidoEn): revertir restaura Paquete →
  // ANULADO y el ledger de sueltos, nunca DELETE físico.
  revertido       Boolean   @default(false)
  revertidoEn     DateTime?

  lote     Lote      @relation(fields: [loteId], references: [id], onDelete: Restrict)
  galpon   Galpon    @relation(fields: [galponId], references: [id], onDelete: Restrict)
  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  paquetes Paquete[]

  @@index([creadoEn, revertido])
  @@index([loteId])
}

// ============================================
// MÓDULO 7 — Clientes
// ============================================

enum TipoCliente {
  MAYORISTA
  MINORISTA
  EVENTUAL
}

enum EstadoCliente {
  ACTIVO
  SUSPENDIDO
}

model Cliente {
  id        String        @id @default(uuid())
  nombre    String
  celular   String?
  direccion String?
  tipo      TipoCliente
  estado    EstadoCliente @default(ACTIVO)

  ventas   Venta[]
  creditos Credito[]

  @@index([nombre])
  @@index([estado])
}

// ============================================
// MÓDULO 6 — Punto de Venta
// ============================================

model PrecioKilo {
  id           String   @id @default(uuid())
  precio       Decimal  @db.Decimal(10, 2)
  vigenteDesde DateTime @default(now())
  usuarioId    String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([vigenteDesde])
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
}

model Venta {
  id           String     @id @default(uuid())
  clienteId    String
  usuarioId    String
  fecha        DateTime   @default(now())
  totalCobrado Decimal    @db.Decimal(10, 2)
  descuento    Decimal    @default(0) @db.Decimal(10, 2)
  metodoPago   MetodoPago
  montoContado Decimal?   @db.Decimal(10, 2)
  montoCredito Decimal?   @db.Decimal(10, 2)

  cliente  Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario  Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles DetalleVenta[]
  credito  Credito?

  @@index([fecha])
  @@index([clienteId])
  @@index([metodoPago])
}

enum TipoDetalleVenta {
  PAQUETE
  BANDEJA
  SUELTO
}

model DetalleVenta {
  id                 String           @id @default(uuid())
  ventaId            String
  tipo               TipoDetalleVenta
  paqueteId          String?
  bandejaId          String?
  galponId           String?
  loteId             String?
  cantidadUnidades   Int?
  pesoKg             Decimal          @db.Decimal(6, 3)
  precioKiloAplicado Decimal          @db.Decimal(10, 2)
  subtotal           Decimal          @db.Decimal(10, 2)

  venta   Venta          @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  paquete Paquete?       @relation(fields: [paqueteId], references: [id], onDelete: Restrict)
  bandeja BandejaSuelta? @relation(fields: [bandejaId], references: [id], onDelete: Restrict)
  galpon  Galpon?        @relation(fields: [galponId], references: [id], onDelete: Restrict)
  lote    Lote?          @relation(fields: [loteId], references: [id], onDelete: Restrict)

  @@index([ventaId])
}

model RoturaPaquete {
  id                String   @id @default(uuid())
  paqueteId         String   @unique
  pesoExtraido      Decimal  @db.Decimal(6, 3)
  unidadesExtraidas Int
  unidadesDevueltas Int
  creadoEn          DateTime @default(now())

  paquete Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
}

// Sprint 10 — modelo espejo de RoturaPaquete: mismo criterio de diseño
// exacto (bandejaId @unique, una Bandeja se rompe una sola vez, para
// siempre; sin usuarioId propio, AuditLog ya registra quién y cuándo).
model RoturaBandeja {
  id                String   @id @default(uuid())
  bandejaId         String   @unique
  pesoExtraido      Decimal  @db.Decimal(6, 3)
  unidadesExtraidas Int
  unidadesDevueltas Int
  creadoEn          DateTime @default(now())

  bandeja BandejaSuelta @relation(fields: [bandejaId], references: [id], onDelete: Cascade)
}

// ============================================
// MÓDULO 8 — Créditos y Cobranza
// ============================================

enum EstadoCredito {
  PENDIENTE
  LIQUIDADO
}

model Credito {
  id          String        @id @default(uuid())
  ventaId     String        @unique
  clienteId   String
  montoTotal  Decimal       @db.Decimal(10, 2)
  montoPagado Decimal       @default(0) @db.Decimal(10, 2)
  fechaLimite DateTime
  estado      EstadoCredito @default(PENDIENTE)

  venta   Venta             @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  cliente Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  abonos  HistorialAbonos[]

  @@index([estado, fechaLimite])
  @@index([clienteId])
}

model HistorialAbonos {
  id         String     @id @default(uuid())
  creditoId  String
  fecha      DateTime   @default(now())
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  usuarioId  String

  credito Credito @relation(fields: [creditoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([creditoId])
}

// ============================================
// MÓDULO 9 — Egresos y Personal (D4: sin adjuntos)
// ============================================

enum CategoriaEgreso {
  ALIMENTOS
  INSUMOS_VACUNAS
  SERVICIOS
  MANTENIMIENTO
  VARIOS
}

model Egreso {
  id          String          @id @default(uuid())
  categoria   CategoriaEgreso
  monto       Decimal         @db.Decimal(10, 2)
  descripcion String
  fecha       DateTime        @default(now())
  // Inmutable — ancla la ventana de gracia de anulación (Sprint 12).
  // Distinta de `fecha`, que sí es editable: si la ventana se anclara a
  // `fecha`, editarla podría reabrir o cerrar la ventana de forma
  // impredecible. Ver memory/estado-proyecto.md, cierre de Sprint 12.
  creadoEn    DateTime        @default(now())
  // Mismo patrón que RegistroMortalidad.revertido/revertidoEn: anular
  // restaura nada (Egreso no descuenta ningún contador), solo marca el
  // registro — nunca DELETE físico. Anulable solo dentro de
  // VENTANA_GRACIA_MIN; fuera de esa ventana se corrige editando.
  revertido   Boolean         @default(false)
  revertidoEn DateTime?
  usuarioId   String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([fecha])
  @@index([categoria])
  @@index([creadoEn, revertido])
}

enum EstadoEmpleado {
  ACTIVO
  INACTIVO
}

model Empleado {
  id        String         @id @default(uuid())
  nombre    String
  celular   String?
  cargo     String?
  usuarioId String?        @unique
  estado    EstadoEmpleado @default(ACTIVO)

  usuario           Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sueldoMovimientos SueldoMovimiento[]
}

enum TipoSueldoMovimiento {
  SUELDO_BASE
  ADELANTO
  BONO
  DESCUENTO
}

model SueldoMovimiento {
  id          String               @id @default(uuid())
  empleadoId  String
  tipo        TipoSueldoMovimiento
  monto       Decimal              @db.Decimal(10, 2)
  fecha       DateTime             @default(now())
  descripcion String?
  // Ledger append-only (Sprint 12, sin edición) — `fecha` nunca cambia
  // después del alta, así que sirve de ancla directa para la ventana de
  // gracia sin el riesgo que sí tiene Egreso.creadoEn/fecha.
  revertido   Boolean              @default(false)
  revertidoEn DateTime?

  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  @@index([empleadoId, fecha, revertido])
}

// ============================================
// MÓDULO 11 — Notificaciones Push
// ============================================

model PushSubscription {
  id        String   @id @default(uuid())
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  creadoEn  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}
